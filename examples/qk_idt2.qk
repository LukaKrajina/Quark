// ============================================================================
//  用 QK 编写：函数指针 + IDT 条目打包 + 往返校验
//
//  取 my_handler 的地址，打包进 IDT 条目，再解包恢复，校验往返一致。
//  预期返回 1（解包地址 == 原地址低 32 位）。
// ============================================================================

int32 my_handler() {
    return 1;
}

int32 quark_main() {
    cap<int32> idt = qk_gc_alloc(16);

    // 函数地址低 32 位（内核加载于 <4GB，高 32 位为 0）
    int32 a = addr(&my_handler);

    // 打包 16 字节 IDT 条目
    *(idt + 0) = (a & 65535) | (8 << 16);                    // 偏移低16 + 选择子
    *(idt + 1) = 36352 | (((a >> 16) & 65535) << 16);        // 0x8E00 + 偏移中16
    *(idt + 2) = 0;                                          // 偏移高 32 位
    *(idt + 3) = 0;                                          // 保留

    // 解包低 32 位偏移
    int32 low16 = *(idt + 0) & 65535;
    int32 mid16 = *(idt + 1) >> 16;
    int32 back = low16 | (mid16 << 16);

    if (back == a) { return 1; }
    return 0;
}