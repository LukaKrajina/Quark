// ============================================================================
//  伙伴系统（Buddy System）核心算法 —— 驯龙系统 DragonPmm 的 QK 表达
//
//  驯龙系统（runtime/include/qcos/DragonPmm.hpp，PMM v2）把物理内存按 2 的
//  幂页（order）组织：分配自上而下 split、释放自下而上 merge。其灵魂是三条
//  纯位运算恒等式，本示例在 QK 层逐一验证：
//
//    1. buddy 页编号：buddy(page, order) = page ^ (1 << order)
//    2. split 兄弟块：右半块 = page + (1 << (order-1)) 页
//    3. order 计算：向上取整到 2 的幂（ilog2_ceil）
//
//  预期返回 44：
//     buddy:  1+2+4+8 + 1+4+1 = 21
//     order:  0+1+2+2+3+3    = 11
//     split:  0 + (1<<2)     = 4
//     merge:  (页0,4 合并成 order-3 后) 0 ^ (1<<3) = 8
//     21 + 11 + 4 + 8 = 44
// ============================================================================

int32 ilog2_ceil(int32 v) {
    int32 r = 0;
    while ((1 << r) < v) {
        r = r + 1;
    }
    return r;
}

int32 quark_main() {
    // ---- 1. buddy XOR 恒等式 ----
    int32 s1 = 0;
    s1 = s1 + (0 ^ (1 << 0));   // 页 0 的 order-0 buddy = 1
    s1 = s1 + (0 ^ (1 << 1));   // 页 0 的 order-1 buddy = 2
    s1 = s1 + (0 ^ (1 << 2));   // 页 0 的 order-2 buddy = 4
    s1 = s1 + (0 ^ (1 << 3));   // 页 0 的 order-3 buddy = 8
    s1 = s1 + (3 ^ (1 << 1));   // 页 3 的 order-1 buddy = 1
    s1 = s1 + (6 ^ (1 << 1));   // 页 6 的 order-1 buddy = 4
    s1 = s1 + (5 ^ (1 << 2));   // 页 5 的 order-2 buddy = 1
    // s1 = 1+2+4+8+1+4+1 = 21

    // ---- 2. order 计算（向上取整到 2 的幂）----
    int32 s2 = 0;
    s2 = s2 + ilog2_ceil(1);   // 0
    s2 = s2 + ilog2_ceil(2);   // 1
    s2 = s2 + ilog2_ceil(3);   // 2
    s2 = s2 + ilog2_ceil(4);   // 2
    s2 = s2 + ilog2_ceil(5);   // 3
    s2 = s2 + ilog2_ceil(8);   // 3
    // s2 = 0+1+2+2+3+3 = 11

    // ---- 3. split：order-3 块（8 页）拆成两个 order-2（4 页）----
    //    左半 = 页 0，右半兄弟 = 0 + (1 << (3-1)) = 4
    int32 s3 = 0 + (1 << (3 - 1));   // 4

    // ---- 4. merge：释放页 4 的 order-2 块，其 buddy = 4 ^ (1<<2) = 0 ----
    //    页 0 与页 4 合并成 order-3 块（块首页 0），新 buddy = 0 ^ (1<<3) = 8
    int32 s4 = 0 ^ (1 << 3);   // 8

    return s1 + s2 + s3 + s4;   // 44
}