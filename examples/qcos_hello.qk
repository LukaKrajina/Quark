// ============================================================================
//  QCOS syscall ABI + QMS 数值内核演示
//
//  系统调用号：
//      SYS_LOG = 1    SYS_YIELD = 2    SYS_EXIT = 3    SYS_TIME = 10
//
//  噪声信道模型（qk_qms_gap 的第一个参数）：
//      0 = 去极化 (Depolarizing)
//      1 = 去相位 (Dephasing)
//      2 = 振幅阻尼 (Amplitude Damping)
//      3 = Pauli 信道
//
//  运行： qk run examples/qcos_hello.qk
//         qk ir   examples/qcos_hello.qk     （只生成 LLVM IR，不连守护进程）
// ============================================================================

int32 quark_main() {
    // ---- QCOS 控制台输出 ----
    qk_sys_log(2, "QCOS: hello from QK");
    qk_sys_logi(2, 42);

    // ---- 让出执行单元，并读取单调时钟（毫秒）----
    qk_sys_call(2, 0, 0, 0);
    int32 tick = qk_sys_call(10, 0, 0, 0);
    qk_sys_logi(2, tick);

    // ---- 由谱隙推导混合时间 ----
    //  去极化信道 p = 0.01 的谱隙恰为 0.01
    double gap  = qk_qms_gap(0, 0.01, 0.0);
    //  有效状态空间规模 n = 1024、精度 eps = 0.01 下的混合时间上界
    double tmix = qk_mix_bound(gap, 1024.0, 0.01);
    //  L2 方差收缩到 1% 所需时间（Poincare 不等式 p=2 推论）
    double tvar = qk_qms_conc(gap, 0.01);

    qk_sys_log(2, "QCOS: QMS bounds computed");

    return 0;
}