// ============================================================================
//  纯 QK 编写的完整 QCOS 内核镜像
//
//  集成三部分：
//    1. 串口驱动（outb/inb，16550 UART 初始化 + 写字符）
//    2. 位图内存分配器（qk_gc_alloc + cap + 位运算）
//    3. 中断描述符表条目打包（cap + addr(&quark_main) + 位运算）
//
//  最后向 COM1 串口写 "QCOS" 并停机。返回 1（位图分配成功）。
// ============================================================================

int32 quark_main() {
    // ---- 串口初始化（16550 UART，COM1 = 0x3F8 = 1016）----
    outb(1019, 0);    // LCR 置 0
    outb(1017, 0);    // IER 关中断
    outb(1019, 128);  // LCR 使能 DLAB
    outb(1016, 3);    // 波特率 38400 低字节
    outb(1017, 0);    // 波特率高字节
    outb(1019, 3);    // 8N1，关 DLAB
    outb(1018, 199);  // 使能 FIFO 并清空
    outb(1020, 11);   // IRQ 使能，RTS/DSR

    // ---- 位图分配器：初始化 + 分配页 5 + 校验 ----
    cap<int32> bitmap = qk_gc_alloc(16);
    *(bitmap + 0) = 0;
    *(bitmap + 1) = 0;
    *(bitmap + 2) = 0;
    *(bitmap + 3) = 0;
    *(bitmap + 0) = *(bitmap + 0) | (1 << 5);        // set_bit(5)
    int32 allocated = (*(bitmap + 0) >> 5) & 1;       // test_bit(5) = 1

    // ---- IDT 条目打包（以 quark_main 自身为示例处理函数）----
    cap<int32> idt = qk_gc_alloc(16);
    int32 handler = addr(&quark_main);                // 函数地址低 32 位
    *(idt + 0) = (handler & 65535) | (8 << 16);       // 偏移低16 + 选择子
    *(idt + 1) = 36352 | (((handler >> 16) & 65535) << 16);  // 0x8E00 + 偏移中16
    *(idt + 2) = 0;                                   // 偏移高 32 位
    *(idt + 3) = 0;                                   // 保留

    // ---- 写 "QCOS" 到串口 ----
    while ((inb(1021) & 32) == 0) { }
    outb(1016, 81);    // 'Q'
    while ((inb(1021) & 32) == 0) { }
    outb(1016, 67);    // 'C'
    while ((inb(1021) & 32) == 0) { }
    outb(1016, 79);    // 'O'
    while ((inb(1021) & 32) == 0) { }
    outb(1016, 83);    // 'S'

    // ---- 停机 ----
    unsafe {
        native("hlt");
    }

    return allocated;
}