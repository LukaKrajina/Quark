// ============================================================================
//  任意基构建量子态（basis_state）
//
//  basis_state(theta, phi, value) 用布洛赫球方向 (θ, φ) 参数化任意基，构建
//  该基的本征态：|n̂₊⟩ = cos(θ/2)|0⟩ + e^{iφ} sin(θ/2)|1⟩。
//
//  value=0 取 + 本征态，value=1 取 - 本征态（X 翻转）。
//  标准基特例：
//    Z 基 (θ=0, φ=0)         → |0⟩ / |1⟩
//    X 基 (θ=π/2, φ=0)       → |+⟩ / |-⟩
//    Y 基 (θ=π/2, φ=π/2)     → |+i⟩ / |-i⟩
//
//
//  预期返回 1：zminus 是 Z 基的 |1⟩ 态，Z 测量必得 1。
//
//  运行：qk run examples/qk_basis_state.qk
// ============================================================================

int32 quark_main() {
    // Z 基（计算基）
    auto zplus  = basis_state(0.0, 0.0, 0);              // |0⟩
    auto zminus = basis_state(0.0, 0.0, 1);              // |1⟩

    // X 基（Hadamard 基）：θ = π/2
    auto xplus = basis_state(1.5707963, 0.0, 0);         // |+⟩

    // Y 基：θ = π/2, φ = π/2
    auto yplus = basis_state(1.5707963, 1.5707963, 0);   // |+i⟩

    // 任意方向：任意的 (θ, φ)
    auto arbitrary = basis_state(0.8, 2.1, 0);

    // 测量 |1⟩ 态：Z 基下必坍缩为 1
    return zminus.measure();
}