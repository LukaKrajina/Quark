// ============================================================================
//  位运算验证（内存管理/位图分配器的前置）
//
//  验证 QK 的位运算（| & ^ << >> ~）在 LLVM 层真实可用。
//  预期返回值 293：
//    a=15, b=15|240=255, c=255&15=15, d=1<<4=16, e=16>>1=8,
//    f=15^15=0, g=~0=-1
//    sum = 255+15+16+8+0-1 = 293
// ============================================================================

int32 quark_main() {
    int32 a = 15;
    int32 b = a | 240;
    int32 c = b & 15;
    int32 d = 1 << 4;
    int32 e = d >> 1;
    int32 f = a ^ 15;
    int32 g = ~0;
    return b + c + d + e + f + g;
}