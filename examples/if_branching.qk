// ============================================================================
//  if / else if / else 条件分支
//
//  QK 此前只有 while / for，没有条件分支——`if` 仅存在于词法关键字表中，
//  parser 与 AST 均无对应实现（实测报 "Unexpected token 'if'"）。
//  这次覆盖三种形态：单分支、else-if 链、嵌套分支。
//
//  预期返回值：99
//    x = 1
//    (1) x == 1  ->  r = 10
//    (2) else-if 链命中 x == 1 ->  r = 10 + 2 = 12
//    (3) 嵌套：r == 12 ->  r = 99
//
//  运行： qk ir  examples/if_branching.qk
// ============================================================================

int32 quark_main() {
    int32 x = 1;
    int32 r = 0;

    // (1) 单分支 if / else
    if (x == 1) {
        r = 10;
    } else {
        r = 20;
    }

    // (2) else-if 链（parser 将其表示为「else 分支只含一个 IfStatement」）
    if (x == 0) {
        r = r + 1;
    } else if (x == 1) {
        r = r + 2;
    } else {
        r = r + 3;
    }

    // (3) 嵌套分支
    if (x == 1) {
        if (r == 12) {
            r = 99;
        }
    }

    return r;
}