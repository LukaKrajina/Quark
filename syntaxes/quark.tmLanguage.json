{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quark",
  "scopeName": "source.quark",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#annotations" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.quark",
      "match": "//.*$"
    },
    "annotations": {
      "patterns": [
        {
          "name": "keyword.declaration.quark",
          "match": "@layer\\b"
        },
        {
          "name": "entity.name.tag.quark",
          "match": "@\\[[a-z_]+"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.quark",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.quark", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.quark",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.quark", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.quark", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.quark", "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.quark",
      "match": "\\b(true|false|null)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.classical.quark",
          "match": "\\b(int|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|double|string|char|bool)\\b"
        },
        {
          "name": "storage.type.quantum.quark",
          "match": "\\b(Qubit|QObject|QModel|QRegister|Result|DiracState|BellState|QuantumRegister|QReservoir)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.quark",
          "match": "\\b(if|else|while|for|return|break|continue|spawn|entangle|spin|route|fuse|fallback|new|auto|let|fn|result|unsafe)\\b"
        },
        {
          "name": "keyword.other.quark",
          "match": "\\b(mod|use|pub|form|impl|trait|template|rank|self|lattice|export|import|extern|requires|ensures|invariant|from|make|cap|native|fixed|flavor|addr|basis_state|path)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.quantum.quark",
          "match": "\\b(alloc|measure|measure_x|measure_y|encode_text|encode_image|qlm_invoke|qlm_load|qlm_forward|mind_read|mind_train|mind_feedback|veda_qlm_train|h|x|rz|cnot|toffoli|swap|qft|iqft|braid|cx|ch|crz|cswap|c_toffoli|cqft|cbraid)\\b"
        },
        {
          "name": "support.function.builtin.quark",
          "match": "\\b(qchain_[a-z_]+|qk_[a-z_]+|sync_[a-z_]+|cgui_[a-z_]+|cgfx_[a-z_]+|qrc_[a-z_]+|lattice_[a-z_]+|outb|inb|surrogate|tanh_quantize|lif_step|mellowmax2|logsumexp2|boltzmann2|tnorm_luk|tnorm_prod|tnorm_godel|polymer_weight|polymer_mix_bound)\\b"
        }
      ]
    }
  }
}
